# Database connection string (SQLite relative to prisma/ dir, or PostgreSQL URL)
DATABASE_URL="file:../db/custom.db"

# Session signing secret (generate a random 32+ byte hex string in production)
SESSION_SECRET=""

# Public base URL for the site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Server-only Gemini AI key (optional — required for AI Course Path Guide)
GEMINI_API_KEY=""

# Optional integration environment variables (leave blank if unconfigured)
SMTP_HOST=""
SMTP_USER=""
SMS_API_KEY=""
ZARINPAL_MERCHANT_ID=""
CHAMILO_BASE_URL=""
CHAMILO_API_KEY=""

